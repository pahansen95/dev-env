#!/usr/bin/env bash
# Development environment setup for dev-env project

source .user.env || echo "No User Environment Found"

# Activate virtual environment if it exists
source "${PWD}/.venv/bin/activate" || echo "Warning: No virtual environment found (.venv or venv directory)"

# Add src directory to PYTHONPATH for development
export PYTHONPATH="${PWD}/src:${PYTHONPATH}"

# Set development mode
export DEV_ENV_MODE="development"

# Optional: Set Docker host if using remote Docker
# export DOCKER_HOST="tcp://localhost:2376"

echo "✓ Development environment activated"
echo "  - Virtual environment: $(which python)"
echo "  - PYTHONPATH includes: ${PWD}/src"
